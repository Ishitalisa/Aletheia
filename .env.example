# Copy to .env and fill in. Never commit .env.
# Stages 0-9 need none of these. They are first required at stage 10 (Sepolia deployment).

# --- stage 10: deployment ---
# Sepolia JSON-RPC endpoint (Alchemy / Infura / dRPC / self-hosted)
SEPOLIA_RPC_URL=
# Etherscan API key, used only for contract verification
ETHERSCAN_API_KEY=
# Deployer key: 0x + 64 hex. Read from this file — hardhat.config.ts loads the
# repository-root .env and preflight.ts reads it here too. Use a throwaway key that
# only ever holds Sepolia faucet ETH; .env is gitignored and never printed.
SEPOLIA_PRIVATE_KEY=

# --- stage 12: subgraph ---
# Deploy key from https://thegraph.com/studio (per-subgraph)
GRAPH_DEPLOY_KEY=
# Studio query endpoint for the deployed subgraph, filled in after stage 12
GRAPH_QUERY_URL=

# --- stage 14: ENS resolution (read-only, mainnet) ---
# Mainnet endpoint used ONLY to resolve ENS names to addresses via the
# Universal Resolver. No writes, no ENS state is ever created by Aletheia.
MAINNET_RPC_URL=

# --- stage 16: frontend ---
# Optional: only needed for non-injected wallet connectors
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
