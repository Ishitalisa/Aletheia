{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // Nothing here is consumed as a library, and viem's contract types are far too
    // large to serialise into declarations: with `declaration` on, tsc fails on the
    // deployment helper's inferred type rather than on anything real.
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": [
    "hardhat.config.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "ignition/**/*.ts",
    "../../types/*.d.ts",
    // Contract ABI types generated by `hardhat compile`. Without these, every
    // `viem.deployContract` call is untyped and typos in a function or event name are
    // only caught at runtime.
    "artifacts/**/*.d.ts"
  ]
}
