{
  "name": "@aletheia/web",
  "version": "0.0.0",
  "private": true,
  "description": "Phase 1 holder flow. A browser app that extracts a passport MRZ, lets the holder review and correct it, signs a mock-dev credential, proves an age claim, and submits it to Sepolia — all client-side, so the document never leaves the device.",
  "scripts": {
    "predev": "node --experimental-strip-types scripts/copy-assets.ts",
    "dev": "next dev",
    "prebuild": "node --experimental-strip-types scripts/copy-assets.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "copy-assets": "node --experimental-strip-types scripts/copy-assets.ts"
  },
  "dependencies": {
    "@aletheia/circuits": "workspace:*",
    "@aletheia/credential": "workspace:*",
    "@aletheia/ens": "workspace:*",
    "@aletheia/extraction": "workspace:*",
    "@aletheia/issuer-mock": "workspace:*",
    "@aletheia/query": "workspace:*",
    "next": "15.5.25",
    "pdfjs-dist": "4.10.38",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "snarkjs": "0.7.6",
    "tesseract.js": "7.0.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "typescript": "^5.9.2"
  }
}
