{
  "name": "@aletheia/issuer-mock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "DEVELOPMENT ONLY. A mock trusted issuer that signs normalized credentials with an EdDSA key. It performs no identity verification of any kind.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm --filter @aletheia/credential run build",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "keygen": "node --experimental-strip-types --no-warnings src/cli.ts keygen",
    "sign": "node --experimental-strip-types --no-warnings src/cli.ts sign",
    "verify": "node --experimental-strip-types --no-warnings src/cli.ts verify"
  },
  "dependencies": {
    "@aletheia/credential": "workspace:*",
    "circomlibjs": "0.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "^5.9.2"
  }
}
